# Copy to server/.env for a NEW local setup. Do not overwrite production settings.
NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/shop
PUBLIC_BASE_URL=http://localhost:5001
CORS_ORIGIN=http://localhost:5173,http://localhost:5001
ADMIN_USER=admin
# Set a unique password (12+ characters) and a random secret (32+ characters).
ADMIN_PASS=
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES=2h
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NOVA_POSHTA_API_KEY=
# Exact number of trusted reverse-proxy hops; leave unset for direct local access.
TRUST_PROXY_HOPS=
# Optional absolute path to a JSON array of street names for local autocomplete.
STREET_SUGGESTIONS_FILE=
# Only needed if a separate API origin is used by the browser.
CSP_CONNECT_ORIGINS=
